set shell := ["zsh", "-cu"]

DOMAIN_ALIASES := ":+realworld"

import 'justfiles/gh.just'

list:
    just --list

# Check what this workspace needs on PATH.
#
# Short, because the toolchain is short: a JDK, the Clojure CLI and Docker.
# flake.nix provides all three; this is what tells you what is missing when
# it is not active.

# Check the toolchain this workspace needs is on PATH
doctor:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    need() {
      if command -v "$1" >/dev/null 2>&1; then
        printf '  %-8s \033[32m%s\033[0m\n' "$1" "$(command -v "$1")"
      else
        printf '  %-8s \033[31mmissing\033[0m\n' "$1"
        fail=1
      fi
    }
    echo "Toolchain:"
    need java
    need clojure
    need docker
    if [ "$fail" -ne 0 ]; then
      echo
      echo "Run 'direnv allow' to get these from flake.nix, or install them."
      exit 1
    fi

# Prep any brick that declares :deps/prep-lib. Nothing in the starter does,
# so this is a no-op until you add a brick that generates code — it is here
# because that is a normal thing to want, not because you need it now.

# Run codegen for any brick declaring :deps/prep-lib
setup:
    clojure -X:deps prep :aliases '[{{ DOMAIN_ALIASES }} :dev]'

# Start nREPL server
repl:
    find . -name .nrepl-port -not -path ./.nrepl-port -delete
    clojure -M{{ DOMAIN_ALIASES }}:dev:test:nrepl -Sforce -P

# Start Rebel Readline REPL
rebel:
    clj -M{{ DOMAIN_ALIASES }}:dev:test:rebel

# Start polylith shell
shell:
    clj -M:poly shell

# Check the workspace
check:
    clojure -M:poly check

# Build all polylith projects as uberjars
build snapshot="true":
    #!/usr/bin/env zsh
    for project in projects/*/; do
        echo "Building ${project:t}..."
        (cd "$project" && clojure -X:build uber :snapshot {{ snapshot }})
    done

# Run the official RealWorld conformance suite against a live service.
#
# Not part of `just test`: it needs a real server on a fixed port and a real
# postgres, which is a different shape of thing from a brick test. The suite
# is vendored under bases/realworld-api/test-resources; where it and your
# own tests disagree, it wins.

# Run the official RealWorld conformance suite against a live service
realworld-hurl port="8091" project="{{main}}":
    #!/usr/bin/env bash
    set -uo pipefail
    root="$PWD"
    hurl_dir="$root/bases/realworld-api/test-resources/realworld-api/hurl"
    log="$root/target/realworld-hurl.log"
    mkdir -p "$(dirname "$log")"

    if ! command -v hurl >/dev/null 2>&1; then
      echo "hurl is not on PATH. Install it from https://hurl.dev, or add"
      echo "pkgs.hurl to flake.nix and re-enter the devshell."
      exit 1
    fi

    cleanup() {
      [ -n "${service_pid:-}" ] && kill "$service_pid" 2>/dev/null
      docker rm -f realworld-pg >/dev/null 2>&1
    }
    trap cleanup EXIT

    if lsof -nP -iTCP:{{ port }} -sTCP:LISTEN >/dev/null 2>&1; then
      echo "port {{ port }} is in use; pass another, e.g. just realworld-hurl 8099"
      exit 1
    fi

    if [ ! -d "$root/projects/{{ project }}" ]; then
      echo "there is no projects/{{ project }}. Pass the project that serves"
      echo "the API, e.g. just realworld-hurl {{ port }} some-service"
      exit 1
    fi

    docker rm -f realworld-pg >/dev/null 2>&1
    docker run -d --name realworld-pg -p 55432:5432 \
      -e POSTGRES_USER=realworld -e POSTGRES_PASSWORD=realworld \
      -e POSTGRES_DB=realworld postgres:16.2 >/dev/null
    echo "waiting for postgres..."
    for _ in $(seq 1 60); do
      docker exec realworld-pg pg_isready -U realworld >/dev/null 2>&1 && break
      sleep 1
    done

    export REALWORLD_DB_HOST=localhost REALWORLD_DB_PORT=55432
    export REALWORLD_DB_NAME=realworld REALWORLD_DB_USER=realworld
    export REALWORLD_DB_PASSWORD=realworld
    export REALWORLD_JWT_SECRET=conformance-secret-not-for-production
    export REALWORLD_PORT={{ port }}

    # From the project rather than :dev, which carries :main-opts for portal.
    # Pass `project` if you serve the API from a project other than this one.
    (cd projects/{{ project }} && \
      clojure -M -m {{top-ns}}.realworld-api.main \
        --config-file classpath:realworld-api/application.yml \
        --profile default) >"$log" 2>&1 &
    service_pid=$!

    echo "waiting for the service on {{ port }}..."
    ready=false
    for _ in $(seq 1 120); do
      if curl -fsS "http://localhost:{{ port }}/api/tags" >/dev/null 2>&1; then
        ready=true; break
      fi
      kill -0 "$service_pid" 2>/dev/null || break
      sleep 1
    done

    if [ "$ready" != true ]; then
      echo "the service never became ready; its output was:"
      tail -40 "$log"
      exit 1
    fi

    hurl --test --jobs 1 \
      --variable host="http://localhost:{{ port }}" \
      --variable uid="$(date +%s)" \
      "$hurl_dir"/*.hurl

# Run all polylith project tests
test: start-docker
    JUNIT_NS_PREFIX={{top-ns}}. clojure -M:poly test :all

# Linter
lint:
    clojure -M:lint/clj-kondo --lint bases components projects deps.edn workspace.edn

# Formatter - uses .zprint.edn config in project root
format:
    #!/usr/bin/env bash
    set -e
    echo "Formatting Clojure source files..."
    files=$(git ls-files '*.clj' '*.cljc' '*.cljs' | while read f; do [ -f "$f" ] && echo "$f"; done)
    if [ -n "$files" ]; then
        echo "$files" | xargs clojure -M:format/zprint '{:search-config? true}' -w
        echo "✓ Formatting complete"
    else
        echo "No Clojure files found"
    fi

force-prep:
    clojure -X:deps prep :aliases '[{{ DOMAIN_ALIASES }} :dev]' :force true

# Start Docker via Colima
start-docker:
    colima status 2>/dev/null || colima start --arch aarch64 --vm-type vz --vz-rosetta --cpu 6 --memory 12
    docker context use colima

# Stop Docker via Colima
stop-docker:
    colima stop

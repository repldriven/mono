;; core.async is required by this brick's own sources. It was previously
;; supplied only by the workspace :dev alias, which meant the brick resolved
;; inside mono and failed at require time for any consumer of mono-lib.
{:aliases {:test {:extra-deps {} :extra-paths ["test" "test-resources"]}}
 ;; Exclude bcprov-ext; vault-clj provides bcprov-jdk18on instead
 ;; Caffeine is declared optional by pulsar-client-all, so it is not resolved
 ;; transitively, but MessageCryptoBc needs it for its encryption key caches
 :deps {org.clojure/core.async {:mvn/version "1.9.865"}
        com.github.ben-manes.caffeine/caffeine {:mvn/version "3.2.4"}
        org.apache.pulsar/pulsar-client-all
        {:mvn/version "4.2.4" :exclusions [org.bouncycastle/bcprov-ext-jdk18on]}
        org.clojure/java.data {:mvn/version "1.4.120"}}
 :paths ["src"]}

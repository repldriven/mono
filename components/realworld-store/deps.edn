;; The postgres driver is a test dep, matching `jdbc`: a brick stays
;; driver-agnostic and the deploying project chooses. `realworld-service`
;; declares it for real.
{:aliases {:test {:extra-deps {org.postgresql/postgresql {:mvn/version
                                                          "42.7.14"}}
                  :extra-paths ["test" "test-resources"]}}
 :deps {}
 :paths ["src" "resources"]}

;; opentelemetry-sdk-testing lives here, not in the telemetry component, and
;; this brick ships in mono-test-lib only. The jar registers a
;; ContextStorageProvider over SPI, and OpenTelemetry adopts a sole provider
;; silently — on a runtime classpath that swaps every service's default
;; thread-local context storage for the settable test one.
{:aliases {:test {:extra-deps {} :extra-paths ["test" "test-resources"]}}
 :deps {com.github.steffan-westcott/clj-otel-api {:mvn/version "0.2.10"}
        com.github.steffan-westcott/clj-otel-sdk {:mvn/version "0.2.11"}
        io.opentelemetry/opentelemetry-sdk-testing {:mvn/version "1.54.1"}}
 :paths ["src"]}

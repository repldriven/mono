{
  "realm": "mono",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "clientScopes": [
    {
      "name": "aud-a",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-a",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "aud-a",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-b",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-b",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "aud-b",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mono-admin",
      "secret": "mono-admin-test-secret",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "mono-viewer",
      "secret": "mono-viewer-test-secret",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-mono-admin",
      "enabled": true,
      "serviceAccountClientId": "mono-admin",
      "clientRoles": {
        "realm-management": [
          "manage-clients",
          "view-clients"
        ]
      }
    },
    {
      "username": "service-account-mono-viewer",
      "enabled": true,
      "serviceAccountClientId": "mono-viewer",
      "clientRoles": {
        "realm-management": [
          "view-clients"
        ]
      }
    }
  ]
}

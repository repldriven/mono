  ;; pay for its infrastructure. It is the starter the template ships, and
  ;; needs only postgres.
  :+realworld {:extra-deps {components/realworld-domain
                            {:local/root "components/realworld-domain"}
                            components/realworld-store
                            {:local/root "components/realworld-store"}
                            bases/realworld-api
                            {:local/root "bases/realworld-api"}
                            org.postgresql/postgresql {:mvn/version "42.7.13"}}
               :extra-paths ["components/realworld-domain/test"
                             "components/realworld-store/test"
                             "components/realworld-store/test-resources"
                             "bases/realworld-api/test"
                             "bases/realworld-api/test-resources"]}

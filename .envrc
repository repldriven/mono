source_up_if_exists
if has nix; then
  use flake .
else
  echo "nix not found — run scripts/check-setup.sh for install instructions"
fi

# Hooks live in the git dir, which is not versioned, so the tracked
# scripts do nothing until they are copied in. Entering the primary
# checkout is the one moment that reliably happens — and direnv is
# allowed per directory, so this does not fire in a worktree.
if has just; then
  just install-hooks
  # And the rules themselves, on every entry rather than only the first:
  # a pull that changes plugins/ would otherwise leave the installed
  # copies behind their sources until someone remembered. post-checkout
  # covers a fresh worktree, but cannot cover this checkout, whose own
  # creation ran before there was any hook to run.
  just tessl-plugins-install
fi

source_up_if_exists
if has nix; then
  use flake .
else
  echo "nix not found — run scripts/check-setup.sh for install instructions"
fi

# Hooks live in the git dir, which is not versioned, so the tracked
# scripts do nothing until they are copied in. Entering the primary
# checkout is the one moment that reliably happens — and direnv is
# allowed per directory, so this does not fire in a worktree.
if has just; then
  just install-hooks
  # And the rules themselves, which post-checkout installs for a worktree
  # but cannot install here: a clone's own checkout runs before there is
  # any hook to run.
  [ -f .tessl/RULES.md ] || just tessl-plugins-install
fi

;; The RealWorld example, as a deployable service.
;;
;; The postgres driver is named here because `jdbc` stays deliberately
;; driver-agnostic.
{:paths ["resources"]
 :deps {components/auth {:local/root "../../components/auth"}
        components/cli {:local/root "../../components/cli"}
        components/command {:local/root "../../components/command"}
        components/command-processor {:local/root
                                      "../../components/command-processor"}
        components/env {:local/root "../../components/env"}
        components/error {:local/root "../../components/error"}
        components/identity-provider {:local/root
                                      "../../components/identity-provider"}
        components/jdbc {:local/root "../../components/jdbc"}
        components/json {:local/root "../../components/json"}
        components/log {:local/root "../../components/log"}
        components/message-bus {:local/root "../../components/message-bus"}
        components/migrator {:local/root "../../components/migrator"}
        components/processor {:local/root "../../components/processor"}
        components/server {:local/root "../../components/server"}
        components/system {:local/root "../../components/system"}
        components/telemetry {:local/root "../../components/telemetry"}
        components/utility {:local/root "../../components/utility"}
        components/realworld-domain {:local/root
                                     "../../components/realworld-domain"}
        components/realworld-store {:local/root
                                    "../../components/realworld-store"}
        bases/realworld-api {:local/root "../../bases/realworld-api"}
        org.postgresql/postgresql {:mvn/version "42.7.13"}
        org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases
 {:test
  {:extra-deps
   {components/http-client {:local/root "../../components/http-client"}
    components/test-resources {:local/root "../../components/test-resources"}
    components/test-system {:local/root "../../components/test-system"}
    components/test-telemetry {:local/root "../../components/test-telemetry"}
    components/testcontainers {:local/root "../../components/testcontainers"}
    bases/external-test-runner {:local/root
                                "../../bases/external-test-runner"}}
   ;; logback-test.xml lives here, not in resources: a config on the
   ;; deployment's own path ships inside the uberjar
   :extra-paths ["test-resources"]}
  :build {:extra-deps {bases/build {:local/root "../../bases/build"}}
          :ns-default com.repldriven.mono.build.build
          :exec-args {:lib com.repldriven.mono/realworld-service
                      :main com.repldriven.mono.realworld-api.main}}}}
